{
  "name": "gnaegi-al",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,tanja \"vite\" \"npm --prefix tanja run dev -- -p 4001\"",
    "build": "vite build && npm --prefix tanja install --include=dev && npm --prefix tanja run build",
    "heroku-postbuild": "npm run build",
    "preview": "vite preview",
    "start": "concurrently -k -n web,tanja \"node server.js\" \"npm --prefix tanja start -- -p 4001\""
  },
  "dependencies": {
    "concurrently": "^10.0.5",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.10.1",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "vite": "^7.2.7"
  }
}
